---
import "@/styles/global.css";
import JsonLd from "@/components/seo/JsonLd.astro";
import { defaultLocale, locales, useTranslations, type AppLocale } from "@/i18n";
import { getBaseUrl } from "@/lib/site";
import { LOCALE_REDIRECT_SCRIPT } from "@/lib/locale-inline-script";
import { THEME_INIT_SCRIPT } from "@/lib/theme-inline-script";

interface Props {
  locale: AppLocale;
  title: string;
  description: string;
  ogDescription?: string;
  siteName?: string;
  /** Relative path within a locale ("" = home). */
  path?: string;
}

const {
  locale,
  title,
  description,
  ogDescription = description,
  siteName,
  path = "",
} = Astro.props;

const t = useTranslations(locale, "Metadata");
const resolvedSiteName = siteName ?? t("siteName");
const baseUrl = getBaseUrl();
const isRtl = locale === "ar";
const dir = isRtl ? "rtl" : "ltr";

const cleanPath = path.replace(/\/+$/, "").replace(/^\//, "");
const suffix = cleanPath ? `/${cleanPath}` : "";
const canonical = `${baseUrl}/${locale}${suffix}`;
const defaultHref = `${baseUrl}/${defaultLocale}${suffix}`;

const ogLocale = isRtl ? "ar_SY" : "en_US";
const alternateLocale = isRtl ? "en_US" : "ar_SY";

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const gtagInline = gaId
  ? `window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${gaId}');`
  : "";
---

<!doctype html>
<html lang={locale} dir={dir} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="manifest" href={`/manifest.${locale}.json`} />

    <link rel="icon" href="/favicon-light.ico" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.ico" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    {locales.map((loc) => (
      <link rel="alternate" hreflang={loc} href={`${baseUrl}/${loc}${suffix}`} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={resolvedSiteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:image" content={`${baseUrl}/og-${locale}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={resolvedSiteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={`${baseUrl}/og-${locale}.png`} />

    <!-- تلوين شريط المتصفح في أجهزة الجوال -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <!-- أيقونة الشاشة الرئيسية لأجهزة iOS -->
    <!-- <link rel="apple-touch-icon" href="/apple-touch-icon.png" /> -->

    <script is:inline set:html={LOCALE_REDIRECT_SCRIPT}></script>
    <script is:inline set:html={THEME_INIT_SCRIPT}></script>

    <JsonLd locale={locale} />

    {gaId ? (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://www.google-analytics.com" />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <link rel="dns-prefetch" href="https://www.google-analytics.com" />
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={gtagInline}></script>
      </>
    ) : null}
  </head>
  <body class="min-h-full flex flex-col bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
