---
import "@/styles/global.css";
import JsonLd from "@/components/seo/JsonLd.astro";
import { defaultLocale, locales, useTranslations, type AppLocale } from "@/i18n";
import { getBaseUrl } from "@/lib/site";
import { LOCALE_REDIRECT_SCRIPT } from "@/lib/locale-inline-script";
import { THEME_INIT_SCRIPT } from "@/lib/theme-inline-script";

interface Props {
  locale: AppLocale;
  title: string;
  description: string;
  ogDescription?: string;
  siteName?: string;
  /** Relative path within a locale ("" = home). */
  path?: string;
}

const {
  locale,
  title,
  description,
  ogDescription = description,
  siteName,
  path = "",
} = Astro.props;

const t = useTranslations(locale, "Metadata");
const resolvedSiteName = siteName ?? t("siteName");
const baseUrl = getBaseUrl();
const isRtl = locale === "ar";
const dir = isRtl ? "rtl" : "ltr";

const cleanPath = path.replace(/\/+$/, "").replace(/^\//, "");
const suffix = cleanPath ? `/${cleanPath}` : "";
const canonical = `${baseUrl}/${locale}${suffix}`;
const defaultHref = `${baseUrl}/${defaultLocale}${suffix}`;

const ogLocale = isRtl ? "ar_SY" : "en_US";
const alternateLocale = isRtl ? "en_US" : "ar_SY";

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang={locale} dir={dir} class="h-full">
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={title} />
    <link rel="manifest" href={`/manifest.${locale}.json`} />

    <!-- Canonical & i18n Alternate Links -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    {locales.map((loc) => (
      <link rel="alternate" hreflang={loc} href={`${baseUrl}/${loc}${suffix}`} />
    ))}

    <!-- Open Graph (Social Sharing) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={resolvedSiteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:image" content={`${baseUrl}/og-${locale}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={resolvedSiteName} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={`${baseUrl}/og-${locale}.png`} />

    <!-- Mobile Browser Theme Color -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    <!-- Core Inline Scripts -->
    <script is:inline set:html={LOCALE_REDIRECT_SCRIPT} />
    <script is:inline set:html={THEME_INIT_SCRIPT} />

    <!-- Structured Data -->
    <JsonLd locale={locale} />

    <!-- Google Analytics (Deferred to optimize TBT) -->
    {gaId && (
    <script is:inline set:html={`
      function loadGTM() {
        if (window.gtmLoaded) return;
        window.gtmLoaded = true;
        const script = document.createElement('script');
        script.src = 'https://www.googletagmanager.com/gtag/js?id=${gaId}';
        script.async = true;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${gaId}');
      }

      ['pointerdown', 'scroll', 'keydown', 'mousemove'].forEach(event => 
        window.addEventListener(event, loadGTM, { once: true, passive: true })
      );
      setTimeout(loadGTM, 4000);
    `} />
  )}
  </head>
  <body class="min-h-full flex flex-col bg-background text-foreground antialiased">
    <slot />
  </body>
</html>