---
import "@/styles/global.css";
import JsonLd from "@/components/seo/JsonLd.astro";
import WebMcp from "@/components/seo/WebMcp.astro";
import { defaultLocale, locales, useTranslations, type AppLocale } from "@/i18n";
import { getBaseUrl } from "@/lib/site";
import { LOCALE_REDIRECT_SCRIPT } from "@/lib/locale-inline-script";
import { THEME_INIT_SCRIPT } from "@/lib/theme-inline-script";

interface Props {
  locale: AppLocale;
  title: string;
  description: string;
  ogDescription?: string;
  /** Absolute URL or root-relative path (e.g. "/og-service.png"). */
  ogImage?: string;
  siteName?: string;
  /** Relative path within a locale ("" = home). */
  path?: string;
}

const {
  locale,
  title,
  description,
  ogDescription = description,
  ogImage,
  siteName,
  path = "",
} = Astro.props;

const t = useTranslations(locale, "Metadata");
const resolvedSiteName = siteName ?? t("siteName");
const baseUrl = getBaseUrl();
const isRtl = locale === "ar";
const dir = isRtl ? "rtl" : "ltr";

// خريطة أكواد hreflang الكاملة لرفع كفاءة السيو الدولي والمحلي
const HREFLANG_MAP: Record<AppLocale, string> = {
  ar: "ar-SY",
  en: "en-US",
};

// تنظيف آمن للمسار ضد التكرار، الهاش، المعلمات، والشرطات المزدوجة
const cleanPath = path
  .replace(/[?#].*$/, "")
  .replace(/\.\./g, "")
  .replace(/\/{2,}/g, "/")
  .replace(/^\/+|\/+$/g, "");

const suffix = cleanPath ? `/${cleanPath}` : "";
const canonical = `${baseUrl}/${locale}${suffix}`;
const defaultHref = `${baseUrl}/${defaultLocale}${suffix}`;

const ogLocale = isRtl ? "ar_SY" : "en_US";
const alternateLocale = isRtl ? "en_US" : "ar_SY";

// صورة OG: دعم مخصصة لكل صفحة مع تطبيع المسار إلى URL مطلق
const ogImageUrl = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${baseUrl}${ogImage.startsWith("/") ? ogImage : `/${ogImage}`}`
  : `${baseUrl}/og-${locale}.png`;

const ogImageAlt =
  locale === "ar"
    ? `${resolvedSiteName} — خدمات الشحن واللوجستيات`
    : `${resolvedSiteName} — Freight & Logistics Services`;

// وصف الصورة الافتراضية فقط عند استخدام الصورة الافتراضية
const hasCustomOgImage = Boolean(ogImage);

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || null;
const GA_FALLBACK_DELAY_MS = 4000;

const twitterHandle = "@feyzo_logistics";
---

<!doctype html>
<html lang={locale} dir={dir} class="h-full">
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator ?? "Astro"} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Robots & Crawler Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={resolvedSiteName} />
    <link rel="manifest" href={`/manifest.${locale}.json`} />

    <!-- Canonical & i18n Alternate Links -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    {locales.map((loc) => (
      <link
        rel="alternate"
        hreflang={HREFLANG_MAP[loc]}
        href={`${baseUrl}/${loc}${suffix}`}
      />
    ))}

    <!-- Open Graph (Social Sharing) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={resolvedSiteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    {!hasCustomOgImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
      </>
    )}
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Mobile Browser Theme Color -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    <!-- Preconnect & DNS-Prefetch for External Analytics -->
    {gaId && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
      </>
    )}

    <!-- Core Inline Scripts -->
    <script is:inline set:html={LOCALE_REDIRECT_SCRIPT} />
    <script is:inline set:html={THEME_INIT_SCRIPT} />

    <!-- Structured Data -->
    <JsonLd locale={locale} />

    <!-- WebMCP Component -->
    <WebMcp locale={locale} />

    <!-- Google Analytics (Deferred, safe, onload-handled) -->
    {gaId && (
      <script
        is:inline
        set:html={`
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());

          (function () {
            const events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
            let timer;

            function loadGTM() {
              if (window.gtmLoaded) return;
              window.gtmLoaded = true;

              events.forEach(event => window.removeEventListener(event, loadGTM));
              if (timer) clearTimeout(timer);

              const script = document.createElement('script');
              script.src = 'https://www.googletagmanager.com/gtag/js?id=${gaId}';
              script.async = true;
              script.onload = () => window.gtag('config', '${gaId}');
              document.head.appendChild(script);
            }

            events.forEach(event =>
              window.addEventListener(event, loadGTM, { once: true, passive: true })
            );
            timer = setTimeout(loadGTM, ${GA_FALLBACK_DELAY_MS});
          })();
        `}
      />
    )}
  </head>
  <body class="min-h-full flex flex-col bg-background text-foreground antialiased">
    <slot />
  </body>
</html>