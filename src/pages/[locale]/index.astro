---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales, useTranslations, type AppLocale } from "@/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: AppLocale };
const t = useTranslations(locale, "Metadata");
---

<BaseLayout
  locale={locale}
  title={t("title")}
  description={t("description")}
  ogDescription={t("ogDescription")}
>
  <main class="min-h-screen w-full">
    <section class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center justify-center gap-6 px-6 text-center">
      <h1 class="text-4xl font-semibold tracking-tight text-foreground md:text-5xl">
        {t("siteName")}
      </h1>
      <p class="max-w-xl text-lg leading-relaxed text-muted-foreground">
        {t("description")}
      </p>
    </section>
  </main>
</BaseLayout>
