---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/landing/Navbar.astro";
import Hero from "@/components/landing/Hero.astro";
import Services from "@/components/landing/Services.astro";
import About from "@/components/landing/About.astro";
import Trust from "@/components/landing/Trust.astro";
import Accreditations from "@/components/landing/Accreditations.astro";
import Contact from "@/components/landing/Contact.astro";
import Footer from "@/components/landing/Footer.astro";
import { locales, useTranslations, type AppLocale } from "@/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: AppLocale };
const t = useTranslations(locale, "Metadata");
---

<BaseLayout
  locale={locale}
  title={t("title")}
  description={t("description")}
  ogDescription={t("ogDescription")}
>
  <main class="min-h-screen w-full">
    <Navbar locale={locale} />
    <Hero locale={locale} />
    <Services locale={locale} />
    <About locale={locale} />
    <Trust locale={locale} />
    <Accreditations locale={locale} />
    <Contact locale={locale} />
    <Footer locale={locale} />
  </main>
</BaseLayout>
