---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import { useTranslations, locales, type AppLocale } from "@/i18n";
import { getContactEmail, getTelephoneE164 } from "@/lib/contact-details";
import Navbar from "@/components/landing/Navbar.astro";
import Footer from "@/components/landing/Footer.astro";

interface Section {
  id: string;
  title: string;
  paragraphs?: string[];
  list?: string[];
  footer?: string;
  contact?: boolean;
}

// ═══ مطلوب لـ Dynamic Routes في وضع SSG ═══
export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: AppLocale };
const t = useTranslations(locale, "PrivacyPolicy");
const tMeta = useTranslations(locale, "Metadata");

const pageTitle = t("title");
const pageDescription = t("subtitle");
const siteName = tMeta("siteName");

const sections = (t.raw("sections") as Section[] | undefined) ?? [];

const contactEmail = getContactEmail();
const contactTelephone = getTelephoneE164();
---

<BaseLayout
  locale={locale}
  title={`${pageTitle} | ${siteName}`}
  description={pageDescription}
  siteName={siteName}
  path="privacy-policy"
>
  <main class="min-h-screen">
     <Navbar locale={locale} />
    <!-- ═══ Hero / Header ═══ -->
    <section class="border-b border-border bg-muted/30 px-4 py-16 md:py-20">
      <div class="container mx-auto max-w-6xl">
        <h1
          class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl lg:text-5xl"
        >
          {pageTitle}
        </h1>
        <p class="mt-4 max-w-3xl text-lg text-muted-foreground md:text-xl">
          {pageDescription}
        </p>
        <p class="mt-6 text-sm text-muted-foreground">
          {t("lastUpdated")}
        </p>
      </div>
    </section>

    <!-- ═══ Content + TOC ═══ -->
    <div class="container mx-auto max-w-6xl px-4 py-12 md:py-16">
      <div class="grid gap-8 lg:grid-cols-[240px_1fr] lg:gap-16">
        <!-- Table of Contents -->
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <nav
            aria-labelledby="toc-heading"
            class="rounded-xl border border-border bg-muted/20 p-4"
          >
            <h2
              id="toc-heading"
              class="text-xs font-semibold uppercase tracking-wider text-foreground"
            >
              {t("tocTitle")}
            </h2>
            <ul class="mt-3 space-y-1.5">
              {sections.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="block text-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
                  >
                    {section.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <!-- Article -->
        <article class="space-y-12">
          {sections.map((section) => (
            <section id={section.id} class="scroll-mt-24">
              <h2
                class="text-xl font-semibold tracking-tight text-foreground md:text-2xl"
              >
                {section.title}
              </h2>

              {section.paragraphs?.map((paragraph) => (
                <p class="mt-4 whitespace-pre-line text-base leading-relaxed text-muted-foreground">
                  {paragraph}
                </p>
              ))}

              {section.list && (
                <ul class="mt-4 space-y-2.5 text-base leading-relaxed text-muted-foreground">
                  {section.list.map((item) => (
                    <li class="relative ps-5 before:absolute before:inset-s-0 before:top-2.5 before:h-1.5 before:w-1.5 before:rounded-full before:bg-foreground/40">
                      {item}
                    </li>
                  ))}
                </ul>
              )}

              {section.contact && (
                <div class="mt-4 flex flex-col gap-2 text-base">
                  <a
                    href={`mailto:${contactEmail}`}
                    class="inline-flex w-fit text-primary underline-offset-4 transition-colors hover:underline"
                  >
                    {contactEmail}
                  </a>
                  <a
                    href={`tel:${contactTelephone}`}
                    dir="ltr"
                    class="inline-flex w-fit text-primary underline-offset-4 transition-colors hover:underline"
                  >
                    {contactTelephone}
                  </a>
                </div>
              )}

              {section.footer && (
                <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                  {section.footer}
                </p>
              )}
            </section>
          ))}
        </article>
      </div>

      <!-- ═══ Contact CTA ═══ -->
      <section
        class="mt-16 rounded-2xl border border-border bg-muted/30 p-8 text-center md:p-12"
      >
        <h2 class="text-2xl font-semibold tracking-tight text-foreground">
          {t("contactSectionTitle")}
        </h2>
        <p class="mt-3 text-base text-muted-foreground">
          {t("contactSectionText")}
        </p>
        <div class="mt-6 flex justify-center">
          <Button href={`/${locale}#contact`} size="lg" class="rounded-full px-8">
            {t("contactCta")}
          </Button>
        </div>
      </section>
    </div>
    <Footer locale={locale} />
  </main>
</BaseLayout>