---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/landing/Navbar.astro";
import Footer from "@/components/landing/Footer.astro";
import Button from "@/components/ui/Button.astro";
import { locales, useTranslations, type AppLocale } from "@/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: AppLocale };
const t = useTranslations(locale, "NotFound");
---


<BaseLayout
  locale={locale}
  title={t("title")}
  description={t("description")}
>
  <main class="min-h-screen w-full">
    <Navbar locale={locale} />
	<div class="container mx-auto flex min-h-[70vh] flex-col items-center justify-center px-4 text-center">
    <span class="text-8xl font-black text-primary">404</span>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      {t("heading")}
    </h1>
    <p class="mt-4 max-w-md text-muted-foreground">
      {t("description")}
    </p>
    <div class="mt-8">
      <Button href={`/${locale}`}>{t("backHome")}</Button>
    </div>
	</div>
    <Footer locale={locale} />
  </main>
</BaseLayout>