---
import { Image } from 'astro:assets';
import { useTranslations, type AppLocale } from "@/i18n";
import { FIATA_WEBSITE_URL, SIFFA_WEBSITE_URL } from "@/lib/site";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale, "Accreditations");
---

<section
  id="accreditations"
  class="scroll-mt-20 border-b border-border bg-background px-4 py-16 md:py-20"
  aria-labelledby="accreditations-heading"
>
  <div class="container mx-auto max-w-6xl">
    <h2
      id="accreditations-heading"
      class="text-center text-2xl font-semibold tracking-tight text-foreground md:text-3xl"
    >
      {t("title")}
    </h2>
    <div class="mx-auto mt-10 max-w-5xl rounded-3xl border border-border bg-muted/20 px-6 py-10 md:px-10 md:py-12">
      <div class="grid gap-12 sm:grid-cols-2 sm:gap-10 md:gap-14">
        <div class="flex min-w-0 flex-col items-center text-center sm:items-center">
          <a
            href={SIFFA_WEBSITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex h-28 w-full max-w-xs items-center justify-center rounded-xl outline-offset-4 transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-ring sm:h-32 md:h-36"
            aria-label={t("siffaLinkAria")}
          >
            <Image
              src="/logo-siffa.png"
              alt={t("siffaLogoAlt")}
              class="max-h-full w-auto max-w-full object-contain object-center"
              width={320}
              height={40}
            />
          </a>
          <p class="mt-5 max-w-sm text-sm font-medium leading-relaxed text-foreground md:text-base">
            {t("memberLineSiffa")}
          </p>
          <a
            href={SIFFA_WEBSITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 text-xs font-medium text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
          >
            {t("siffaWebsiteLink")}
          </a>
        </div>
        <div class="flex min-w-0 flex-col items-center text-center sm:items-center">
          <a
            href={FIATA_WEBSITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex h-28 w-full max-w-xs items-center justify-center rounded-xl outline-offset-4 transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-ring sm:h-32 md:h-36"
            aria-label={t("fiataLinkAria")}
          >
            <Image
              src="/logo-fiata.png"
              alt={t("fiataLogoAlt")}
              class="max-h-full w-auto max-w-full object-contain object-center"
              width={143}
              height={143}
            />
          </a>
          <p class="mt-5 max-w-sm text-sm font-medium leading-relaxed text-foreground md:text-base">
            {t("memberLineFiata")}
          </p>
          <a
            href={FIATA_WEBSITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 text-xs font-medium text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
          >
            {t("fiataWebsiteLink")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
