---
import { getContactEmail, getTelephoneE164 } from "@/lib/contact-details";
import {
  FIATA_WEBSITE_URL,
  getBaseUrl,
  getSocialProfileUrls,
  SIFFA_WEBSITE_URL,
} from "@/lib/site";
import { useTranslations, type AppLocale } from "@/i18n";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale, "Metadata");
const tServices = useTranslations(locale, "Services");
const baseUrl = getBaseUrl();
const pageUrl = `${baseUrl}/${locale}`;
const logoUrl = `${baseUrl}${locale === "ar" ? "/logo-ar.svg" : "/logo-en.svg"}`;
const ogImageUrl = `${baseUrl}/og-${locale}.png`;
const businessId = `${baseUrl}/#business`;
const websiteId = `${baseUrl}/#website`;
const webPageId = `${pageUrl}/#webpage`;
const siffaOrgId = `${baseUrl}/#organization-siffa`;
const fiataOrgId = `${baseUrl}/#organization-fiata`;

/** أسماء الكيان التجاري باللغتين لربط الكيان عابر اللغات (Cross-Language Entity Reconciliation) */
const ENTITY_NAMES = ["Feyzo Logistics", "فيزو للخدمات اللوجستية"] as const;

const businessName = t("siteName");
const rawServiceItems =
  (tServices.raw("items") as { title: string; description: string }[] | undefined) ?? [];

// تصفية الخدمات والتأكد من وجود العنوان والوصف لكل خدمة
const serviceItems = rawServiceItems.filter(
  (item) => item?.title && item?.description
);

// العنوان البريدي — addressCountry بصيغة ISO 3166-1 alpha-2
const postalAddress = {
  "@type": "PostalAddress",
  streetAddress: t("address.streetAddress"),
  addressLocality: t("address.addressLocality"),
  addressRegion: t("address.addressRegion"),
  addressCountry: "SY",
};

// الإحداثيات الجغرافية لمقر الشركة في اللاذقية (قيم رقمية قياسية)
const geoCoordinates = {
  "@type": "GeoCoordinates",
  latitude: 35.5317,
  longitude: 35.7909,
};

// قائمة روابط التواصل الاجتماعي مع تنظيف القوائم الفارغة
const socialUrls = getSocialProfileUrls();
const sameAs = socialUrls.length > 0 ? socialUrls : undefined;

// الأسماء البديلة للكيان مع تنظيف التكرار
const alternateNames = ENTITY_NAMES.filter((n) => n !== businessName);
const alternateName = alternateNames.length > 0 ? alternateNames : undefined;

// كتالوج الخدمات الشامل مع تغليف العناصر بـ ListItem لضبط الترتيب معيارياً
const hasOfferCatalog = {
  "@type": "OfferCatalog",
  name: locale === "ar" ? "خدمات الشحن واللوجستيات" : "Freight & Logistics Services",
  itemListElement: serviceItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: item.title,
        description: item.description,
        provider: { "@id": businessId },
      },
    },
  })),
};

// الجمعية السورية للشحن الدولي SIFFA (مع علاقة عضو عكسية)
const siffaOrganization = {
  "@id": siffaOrgId,
  "@type": "Organization",
  name:
    locale === "ar"
      ? "الجمعية السورية للشحن والإمداد الوطني"
      : "Syrian International Freight Forwarding Association",
  alternateName:
    locale === "ar"
      ? ["SIFFA", "الجمعية السورية لوكلاء الشحن الدولي"]
      : ["SIFFA"],
  url: SIFFA_WEBSITE_URL,
  member: [{ "@id": businessId }],
};

// الاتحاد الدولي لوكلاء الشحن FIATA (مع علاقة عضو عكسية)
const fiataOrganization = {
  "@id": fiataOrgId,
  "@type": "Organization",
  name: "International Federation of Freight Forwarders Associations",
  alternateName:
    locale === "ar"
      ? ["FIATA", "الاتحاد الدولي لجمعيات الشحن والخدمات اللوجستية"]
      : ["FIATA"],
  url: FIATA_WEBSITE_URL,
  member: [{ "@id": businessId }],
};

// وسوم النطاق المعرفي (knowsAbout) لتعريف الذكاء الاصطناعي بمجالات عمل الشركة
const knowsAbout =
  locale === "ar"
    ? [
        "الشحن البحري الدولي",
        "شحن الحاويات FCL و LCL",
        "التخليص الجمركي والترانزيت",
        "شحن البضائع الفريدة والصب Breakbulk",
        "الشحن المبرد Reefer Cargo",
        "مرفأ اللاذقية",
        "مرفأ طرطوس",
        "إدارة الخدمات اللوجستية وسلاسل الإمداد",
      ]
    : [
        "International Freight Forwarding",
        "Ocean Freight Shipping (FCL/LCL)",
        "Customs Clearance & Transit",
        "Breakbulk & Heavy Lift Cargo",
        "Reefer Container Shipping",
        "Port of Latakia",
        "Port of Tartous",
        "Syrian Logistics & Supply Chain",
      ];

const contactEmail = getContactEmail();
const contactTelephone = getTelephoneE164();

const organizationAndLocalBusiness = {
  "@id": businessId,
  "@type": ["Organization", "LocalBusiness"],
  name: businessName,
  legalName: "Feyzo Logistics",
  alternateName,
  identifier: {
    "@type": "PropertyValue",
    propertyID: "domain",
    value: "feyzologistics.com",
  },
  knowsLanguage: ["ar", "en"],
  url: baseUrl,
  image: [ogImageUrl, logoUrl],
  logo: logoUrl,
  description: t("description"),
  telephone: contactTelephone,
  email: contactEmail,
  address: postalAddress,
  geo: geoCoordinates,
  priceRange: "$$",
  sameAs,
  memberOf: [{ "@id": siffaOrgId }, { "@id": fiataOrgId }],
  hasOfferCatalog,
  knowsAbout,
  areaServed: [
    {
      "@type": "Country",
      name: locale === "ar" ? "سوريا" : "Syria",
    },
    {
      "@type": "City",
      name: t("address.addressLocality"),
      containedInPlace: {
        "@type": "Country",
        name: locale === "ar" ? "سوريا" : "Syria",
      },
    },
  ],
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: contactTelephone,
      email: contactEmail,
      contactType: "customer service",
      description: locale === "ar" ? "خدمة العملاء" : "Customer service",
      areaServed: {
        "@type": "Country",
        name: locale === "ar" ? "سوريا" : "Syria",
      },
      availableLanguage: ["ar", "en"],
    },
  ],
};

const website = {
  "@id": websiteId,
  "@type": "WebSite",
  name: businessName,
  url: baseUrl,
  description: t("description"),
  inLanguage: locale === "ar" ? "ar-SY" : "en-US",
  publisher: { "@id": businessId },
};

const webPage = {
  "@id": webPageId,
  "@type": "WebPage",
  name: t("title"),
  description: t("description"),
  url: pageUrl,
  inLanguage: locale === "ar" ? "ar-SY" : "en-US",
  isPartOf: { "@id": websiteId },
  about: { "@id": businessId },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: ogImageUrl,
  },
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    siffaOrganization,
    fiataOrganization,
    organizationAndLocalBusiness,
    website,
    webPage,
  ],
};

const graphJson = JSON.stringify(graph);
---

<script type="application/ld+json" set:html={graphJson}></script>